# Environment Variables Example
# Copy this file to .dev.vars (or .env) for local development
# In production, set secrets via Wrangler CLI:
#   wrangler secret put CSRF_SECRET
#   wrangler secret put ADMIN_SECRET

# CSRF & Session Signing Secret - Generate a random string (at least 32 characters)
# You can generate one with: openssl rand -hex 32
CSRF_SECRET=your-csrf-secret-here

# Admin Fallback Passcode for /inbox login & initial Passkey registration
ADMIN_SECRET=your-admin-passcode-here
