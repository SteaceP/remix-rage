# Environment Variables Example
# Copy this file to .dev.vars (or .env) for local development
# In production, set secrets via Wrangler CLI:
#   wrangler secret put ADMIN_SECRET

# Admin Signing Secret & Fallback Passcode for /inbox login & Passkey registration
# Generate a random string (at least 32 characters)
# You can generate one with: openssl rand -hex 32
ADMIN_SECRET=your-admin-passcode-here
