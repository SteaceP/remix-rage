/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "remix-rage",
    "compatibility_date": "2026-10-19",
    "compatibility_flags": [
        "nodejs_compat"
    ],
    "main": "./workers/app.ts",
    "assets": {
        "directory": "./build/client",
    },
    "routes": [
        {
            "pattern": "coderage.pro/*",
            "zone_name": "coderage.pro",
        },
    ],
    "durable_objects": {
        "bindings": [
            {
                "name": "DIRECT_MESSAGE_HUB",
                "class_name": "DirectMessageHub",
            },
        ],
    },
    "migrations": [
        {
            "tag": "v1",
            "new_sqlite_classes": [
                "DirectMessageHub"
            ],
        },
    ],
    "env": {
        "dev": {
            "routes": [
                {
                    "pattern": "dev.coderage.pro/*",
                    "zone_name": "coderage.pro",
                },
            ],
            "durable_objects": {
                "bindings": [
                    {
                        "name": "DIRECT_MESSAGE_HUB",
                        "class_name": "DirectMessageHub",
                    },
                ],
            },
        },
    },
    "observability": {
        "enabled": true,
    },
    /**
     * Note: Use secrets to store sensitive data.
     * https://developers.cloudflare.com/workers/configuration/secrets/
     *
     * Required secrets (set via CLI, not in this file):
     *   wrangler secret put ADMIN_SECRET
     */
}