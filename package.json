{
    "name": "remix-rage",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "react-router build",
        "cf-typegen": "wrangler types",
        "deploy": "pnpm run build && wrangler deploy",
        "dev": "react-router dev",
        "postinstall": "pnpm run cf-typegen",
        "preview": "pnpm run build && vite preview",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "typecheck": "pnpm run cf-typegen && react-router typegen && tsc -b"
    },
    "dependencies": {
        "@react-router/cloudflare": "^8.4.0",
        "@react-router/fs-routes": "^8.4.0",
        "@tailwindcss/vite": "^4.3.3",
        "isbot": "^5.2.2",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-icons": "^5.7.0",
        "react-router": "^8.4.0",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@cloudflare/vite-plugin": "^1.64.0",
        "@cloudflare/workers-types": "^5.20261018.1",
        "@react-router/dev": "^8.4.0",
        "@types/node": "^26.6.5",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitest/coverage-v8": "^5.0.5",
        "prettier": "^3.9.10",
        "tailwindcss": "^4.3.3",
        "typescript": "^7.0.2",
        "vite": "^8.3.4",
        "vitest": "^5.0.5",
        "wrangler": "^4.151.1"
    },
    "engines": {
        "node": ">=22.12.0",
        "pnpm": ">=9.0.0"
    },
    "packageManager": "pnpm@10.21.0"
}
