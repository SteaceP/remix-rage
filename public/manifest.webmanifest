{
  "name": "Code Rage Direct Inbox",
  "short_name": "CR Inbox",
  "description": "Real-time direct message inbox and availability console for Code Rage.",
  "start_url": "/inbox",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#020617",
  "theme_color": "#2563eb",
  "icons": [
    {
      "src": "/assets/logo/pwa-icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    },
    {
      "src": "/assets/logo/logo-light.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/assets/logo/logo-dark.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ]
}
